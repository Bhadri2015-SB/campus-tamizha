# Development Environment Variables
ENV=development

# Application
APP_NAME=campus Tamizha
APP_VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./campustamizha_dev.db

# JWT Security
SECRET_KEY=your-secret-key-change-in-production-9876543210
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@campustamizha.com
ADMIN_PASSWORD=changeme123

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_TO_FILE=true
LOG_SQL_QUERIES=true

# CORS (use comma-separated values in production)
CORS_ORIGINS=http://localhost:3000